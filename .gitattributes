# Keep repository source files deterministic across Windows, macOS, and Linux.
* text=auto

# Source code and project configuration use LF.
*.dart text eol=lf
*.go text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.mm text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.pro text eol=lf
Dockerfile text eol=lf

# Batch files use CRLF; PowerShell scripts are kept as LF like other sources.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.keystore binary
