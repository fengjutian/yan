APP_ENV=development
HTTP_ADDRESS=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

MYSQL_DATABASE=ai_image_studio
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
DATABASE_DSN=app:change-me@tcp(mysql:3306)/ai_image_studio?parseTime=true

REDIS_ADDR=redis:6379

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-minio-me
MINIO_BUCKET=ai-image-studio
MINIO_USE_SSL=false

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_IMAGE_MODEL=image-01
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
INITIAL_CREDITS=100
IMAGE_MAX_UPLOAD_MB=10
IMAGE_MAX_PIXELS=16777216
IMAGE_THUMBNAIL_SIZE=512
ASSET_URL_TTL=15m
